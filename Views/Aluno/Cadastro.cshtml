@model Cadastro_Alunos_MVC.Models.Aluno

<h2>Cadastro de Aluno</h2>

<form method="post">

    <p>
        Nome:
        <input asp-for="Nome" />
    </p>

    <p>
        RA:
        <input asp-for="RA" />
    </p>

    <p>
        Curso:
        <input asp-for="Curso" />
    </p>

    <p>
        Idade:
        <input asp-for="Idade" />
    </p>

    <button type="submit">
        Cadastrar
    </button>

</form>